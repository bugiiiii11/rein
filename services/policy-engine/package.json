{
  "name": "@reinconsole/policy-engine",
  "version": "0.3.0-rc.1",
  "description": "Rein policy evaluation service — sandboxed declarative rule engine with hash-chained, signed decisions.",
  "license": "MIT",
  "homepage": "https://github.com/bugiiiii11/rein#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugiiiii11/rein.git",
    "directory": "services/policy-engine"
  },
  "bugs": "https://github.com/bugiiiii11/rein/issues",
  "keywords": [
    "rein",
    "x402",
    "policy",
    "spend-control",
    "ai-agents",
    "agent-payments",
    "audit-log"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": ["./dist/server.js"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "bin"],
  "bin": {
    "rein-policy-engine": "./bin/rein-policy-engine.mjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@reinconsole/core": "workspace:^",
    "fastify": "^5.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
