{
  "name": "@reinconsole/x402-rails",
  "version": "0.1.1",
  "description": "Real x402 rails for Rein — EIP-3009 payer, hosted-facilitator client, and on-chain indexer for Base Sepolia.",
  "license": "MIT",
  "homepage": "https://github.com/bugiiiii11/rein#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugiiiii11/rein.git",
    "directory": "services/x402-rails"
  },
  "bugs": "https://github.com/bugiiiii11/rein/issues",
  "keywords": [
    "rein",
    "x402",
    "base",
    "base-sepolia",
    "usdc",
    "eip-3009",
    "viem",
    "payments",
    "ai-agents"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@reinconsole/core": "workspace:^",
    "@reinconsole/sdk": "workspace:^",
    "viem": "^2.47.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@reinconsole/policy-engine": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
