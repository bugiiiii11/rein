{
  "name": "@reinconsole/mock-rails",
  "version": "0.3.0-rc.1",
  "description": "Simulated payment rails for Rein v0.1 — mock x402 facilitator, on-chain ledger, and indexer with shadow-spend detection.",
  "license": "MIT",
  "homepage": "https://github.com/bugiiiii11/rein#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugiiiii11/rein.git",
    "directory": "services/mock-rails"
  },
  "bugs": "https://github.com/bugiiiii11/rein/issues",
  "keywords": ["rein", "x402", "mock", "testing", "payments", "ai-agents"],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@reinconsole/core": "workspace:^",
    "@reinconsole/sdk": "workspace:^",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@reinconsole/policy-engine": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
