{
  "name": "rein",
  "version": "0.0.0",
  "private": true,
  "description": "Rein — the control plane for AI agent payments. Set the rules, watch every payment, score every counterparty.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "smoke": "node scripts/package-smoke.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.6",
      "find-my-way": ">=9.7.0",
      "ws": ">=8.21.0"
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
