# Real x402 rails on Base Sepolia — used by `pnpm --filter @reinconsole/demo demo:sepolia`
# and the gated live tests in @reinconsole/x402-rails. Copy to .env (gitignored).
# (Named env.example, not .env.example: the repo's safety hooks protect .env*.)
# The demo generates and appends the wallet entries automatically on first run.

# --- Invited beta: an agent against the HOSTED engine (Sprint 6) ---------------
# The four values an invitation carries. They go into the MCP server's env block
# (services/mcp/README.md) or createGuard(); nothing in the repo reads them from
# here -- this block is the checklist. The key is org-scoped and narrowed to the
# one agent; the profile is what keeps a testnet key off mainnet, so leave it.
REIN_ENGINE_URL=https://engine.reinconsole.com
REIN_ENGINE_API_KEY=
REIN_AGENT_ID=
REIN_NETWORK_PROFILE=testnet

# --- Real rails on Base Sepolia (the demos and live tests) --------------------

# The agent wallet's private key (testnet only — fund via https://faucet.circle.com).
REIN_SEPOLIA_PRIVATE_KEY=

# Where the demo vendor receives USDC (auto-generated if empty).
REIN_SEPOLIA_VENDOR_ADDRESS=

# Optional RPC override (default: https://sepolia.base.org).
REIN_SEPOLIA_RPC_URL=

# The agent's on-chain ERC-8004 identity (eip155:{chainId}:{registry}/{tokenId}).
# Written automatically by `demo:sepolia-8004` after its one-time registration —
# that demo needs a little Base Sepolia ETH for gas (unlike demo:sepolia; fund at
# https://portal.cdp.coinbase.com/products/faucet). Re-runs are read-only.
REIN_SEPOLIA_ERC8004_ID=

# The counterparty wallet that publishes Rein scores to the REAL Reputation
# Registry (the contract bans self-feedback, so the agent wallet cannot).
# Generated + gas-funded automatically by demo:sepolia-8004's feedback beat.
REIN_SEPOLIA_FEEDBACK_KEY=

# Console real-registry mode: set to `sepolia` and the console world provisions
# a live-identity agent from REIN_SEPOLIA_ERC8004_ID — its link facts (ownerOf,
# agentWallet) and its published rein-score are READ from the real chain at
# boot (payments stay mock; nothing is written on-chain). Needs network + the
# CA var below on this machine.
REIN_CONSOLE_REGISTRY=

# Set to 1 to enable the live (network) tests in @reinconsole/x402-rails and @reinconsole/erc8004.
RUN_LIVE=

# Machines with HTTPS interception (Avast): point Node at the exported root CA
# BEFORE launching, or facilitator/RPC calls fail with cert errors:
#   PowerShell:  $env:NODE_EXTRA_CA_CERTS = "$HOME\.rein-dev-ca.pem"
