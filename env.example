# Real x402 rails on Base Sepolia — used by `pnpm --filter @rein/demo demo:sepolia`
# and the gated live tests in @rein/x402-rails. Copy to .env (gitignored).
# (Named env.example, not .env.example: the repo's safety hooks protect .env*.)
# The demo generates and appends the wallet entries automatically on first run.

# The agent wallet's private key (testnet only — fund via https://faucet.circle.com).
REIN_SEPOLIA_PRIVATE_KEY=

# Where the demo vendor receives USDC (auto-generated if empty).
REIN_SEPOLIA_VENDOR_ADDRESS=

# Optional RPC override (default: https://sepolia.base.org).
REIN_SEPOLIA_RPC_URL=

# Set to 1 to enable the live (network) tests in @rein/x402-rails.
RUN_LIVE=

# Machines with HTTPS interception (Avast): point Node at the exported root CA
# BEFORE launching, or facilitator/RPC calls fail with cert errors:
#   PowerShell:  $env:NODE_EXTRA_CA_CERTS = "$HOME\.rein-dev-ca.pem"
