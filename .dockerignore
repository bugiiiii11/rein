# Keep the build context lean and force a clean install/build inside the image.
.git
**/node_modules
**/dist
**/.turbo
.turbo

# Local runtime state / secrets — never ship these into the image.
.rein-data
.rein-graph-data
.rein-console-data*
.env
**/.env
# `.env` alone is not the file that matters: the operator credentials live in
# .env.engine-ops, .env.pilot and .env.invitee-*. Railway builds from git,
# where those are gitignored, but a local `docker build .` would otherwise
# bake the unscoped engine key into the image.
.env.*
**/.env.*
**/*.pem
*.log
